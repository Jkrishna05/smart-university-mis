# ============================================================
# OIT MIS — Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in real values:
#   cp .env.example .env
# ============================================================

# ── MySQL Database ──────────────────────────────────────────
MYSQL_ROOT_PASSWORD=CHANGE_ME_strong_random_password
MYSQL_DATABASE=university_mis

# ── Backend API ─────────────────────────────────────────────
PORT=5000
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=CHANGE_ME_strong_random_password
DB_NAME=university_mis
JWT_SECRET=CHANGE_ME_64_char_random_hex_string
JWT_EXPIRES_IN=24h
NODE_ENV=production
CORS_ORIGIN=https://mis.oit.edu

# ── Domain (used by Nginx / SSL) ───────────────────────────
DOMAIN=mis.oit.edu
